@keyframes cookieAnimate {
  0% {
    opacity: 0;
    width: 0px;
    height: 0px;
    padding: 0px;
  }
  100% {
    opacity: 1;
    width: 35px;
    height: 35px;
    padding: 10px;
    margin: 6px;
  }
}
@keyframes cookieContentAnimate {
  0% {
    position: relative;
    top: -10px;
    opacity: 0;
  }
  100% {
    position: relative;
    top: 0px;
    opacity: 1;
  }
}
