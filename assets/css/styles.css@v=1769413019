  opacity: 1;
}
.popularTopics .singleTopic img.topicImage {
  position: absolute;
  top: -9999px;
  right: -9999px;
  bottom: -9999px;
  left: -9999px;
  margin: auto;
  -o-object-fit: cover;
  object-fit: cover;
  width: 100%;
  min-height: 100%;
}
.popularTopics .topicImg {
  position: relative;
  width: 118px;
  height: 86px;
  overflow: hidden;
  flex-shrink: 0;
}

