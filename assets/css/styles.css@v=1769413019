.popularTopics .singleTopic .topicContent .topicTag {
    color: #48a515;
    margin: 0;
}
.popularTopics .singleTopic .topicContent .sep {
    margin: 0px 2px;
}
.popularTopics .singleTopic .topicContent .header-date {
    margin: 0;
}
